{
  "name": "acge-cloud-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted cloud browser agent runtime for Arabic Consultant Growth Engine",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "probe": "tsx scripts/probe-platforms.ts"
  },
  "dependencies": {
    "playwright": "1.58.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "tsx": "4.19.2",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
