# ── Cloud browser runtime (cloud-browser/) ────────────────────────────────────
# Shared secret between the dashboard and the runtime. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BROWSER_AGENT_TOKEN=

# 32-byte base64 key used to encrypt stored browser sessions at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BROWSER_AGENT_ENCRYPTION_KEY=

# Runtime listeners / storage
BROWSER_AGENT_PORT=8787
BROWSER_AGENT_HOST=0.0.0.0
BROWSER_AGENT_DATA_DIR=/data
BROWSER_AGENT_HEADLESS=1

# Dashboard origin used for the AI step endpoint (the runtime calls back here)
APP_URL=

# Optional limits
BROWSER_AGENT_MAX_STEPS=14
BROWSER_AGENT_LIVE_TTL_MS=900000
BROWSER_AGENT_APPROVAL_TTL_MS=600000
BROWSER_AGENT_ACTION_COOLDOWN_MS=45000
BROWSER_AGENT_ACTION_DAILY_LIMIT=20

# Keep LinkedIn automation disabled (platform policy). Do not enable casually.
BROWSER_AGENT_ALLOW_LINKEDIN_ACTIONS=0
